# Copy to .env.local for local dev; set the same keys on your host.

# MySQL — on Hostinger these are auto-written by the platform's database
# provisioning when you create the app's Node.js hosting (DB_HOST, DB_PORT,
# DB_NAME, DB_USER, DB_PASSWORD, DATABASE_URL). For other hosts, set manually.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=leadathon
DB_USER=leadathon_user
DB_PASSWORD=change-me
# Alternative: a single connection string (if set, takes precedence over DB_* above)
# DATABASE_URL=mysql://user:password@host:3306/dbname

# Resend (email) — verify a domain to send to any address; test key only mails the account owner
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM=LEADATHON 2026 <onboarding@resend.dev>

# Admin back-office access token (choose a long random string)
ADMIN_TOKEN=change-me-to-a-long-random-token
ADMIN_SECRET=optional-reserved-for-future-use

# Public base URL used inside QR codes / emails (your deployed domain in prod)
PUBLIC_BASE_URL=https://your-domain.vercel.app
